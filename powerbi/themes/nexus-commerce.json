{
  "name": "NEXUS Commerce Intelligence | Midnight Cyan 2026",
  "dataColors": [
    "#47DFF2",
    "#A892F4",
    "#79D9BC",
    "#EFC98D",
    "#629BE8",
    "#D39CE5",
    "#91B3E3",
    "#EFAFBA"
  ],
  "foreground": "#EDF5FF",
  "foregroundNeutralSecondary": "#B8C8DF",
  "foregroundNeutralTertiary": "#91A9C4",
  "background": "#080F20",
  "backgroundLight": "#111E38",
  "backgroundNeutral": "#192946",
  "tableAccent": "#47DFF2",
  "good": "#7ADDB8",
  "neutral": "#EFC98D",
