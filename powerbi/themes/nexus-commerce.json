{
  "name": "NEXUS Commerce Analytics — Navy and Blue",
  "dataColors": [
    "#0572A8",
    "#8F9BFF",
    "#C88335",
    "#CB5D78",
    "#3566B5",
    "#9E76C8",
    "#5A7A90",
    "#D59A64"
  ],
  "foreground": "#091625",
  "foregroundNeutralSecondary": "#415672",
  "foregroundNeutralTertiary": "#667E96",
  "background": "#FFFFFF",
  "backgroundLight": "#F7F8FA",
  "backgroundNeutral": "#DAE5F0",
  "tableAccent": "#0572A8",
  "good": "#487FD8",
  "neutral": "#B47725",
  "bad": "#C24363",
  "maximum": "#0572A8",
  "center": "#7E91CA",
  "minimum": "#E5EFF9",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#091625"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#122942"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#122942"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#415672"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "transparency": 0,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "width": 1,
            "radius": 10,
            "color": {
              "solid": {
                "color": "#D9E1E9"
              }
            }
          }
        ],
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#122942"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#061524"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#F7F8FA"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#E7F2FA"
              }
            }
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "textSize": 11,
            "fontColor": {
              "solid": {
                "color": "#122942"
              }
            }
          }
        ]
      }
    }
  }
}
